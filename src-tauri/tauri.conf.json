{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bach",
  "version": "0.1.0",
  "identifier": "dev.nathan.bach",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:3420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "Bach", "width": 1200, "height": 800, "minWidth": 720, "minHeight": 480 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
